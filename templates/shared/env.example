# Template for .env: copy it to .env on a new machine (cp .env.example .env). Commit this file, never .env.
MONGODB_URI={{mongoUri}}
APP_URL=http://localhost:5001
# 5001, not 3000 or 5000: those are taken by frontend dev servers and, on macOS, AirPlay.
PORT=5001

# Comma separated list of frontend origins allowed by CORS (required in production).
# CORS_ORIGINS=https://app.example.com

# Set when running behind a proxy/load balancer so rate limits see real client IPs.
# TRUST_PROXY=1

# MongoDB server for npm test and calm audit, without a database name (they create and drop
# throwaway databases on it). Defaults to mongodb://127.0.0.1:27017; set it when you use Atlas.
# MONGODB_TEST_URI=

# LOG_LEVEL=info
