# Copy to .env for local development. Never commit .env.
MONGODB_URI={{mongoUri}}
APP_URL=http://localhost:5001
PORT=5001

# Comma separated list of frontend origins allowed by CORS (required in production).
# CORS_ORIGINS=https://app.example.com

# Set when running behind a proxy/load balancer so rate limits see real client IPs.
# TRUST_PROXY=1

# LOG_LEVEL=info
